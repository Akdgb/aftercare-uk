# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Base URL used in emails and redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs session cookies and unsubscribe links. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Postgres (Vercel Postgres / Neon). Added automatically when you connect a
# database to the Vercel project; `vercel env pull .env.local` copies it locally.
POSTGRES_URL=

# Resend — transactional email (sign-in links, invites, reminders).
# Without it, emails are printed to the server console instead of sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
EMAIL_FROM="AfterCare <no-reply@aftercare-uk.co.uk>"

# OpenAI — powers the AI assistant page. Without it the assistant shows an error.
OPENAI_API_KEY=

# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
