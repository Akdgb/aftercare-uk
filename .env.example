# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Base URL used in emails and redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs session cookies and unsubscribe links. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Any Postgres database. For local development, `docker compose up -d` starts
# one that matches this URL. For hosting, use a provider such as Neon or
# Supabase and add ?sslmode=require to the end of their connection string.
DATABASE_URL=postgres://aftercare:aftercare@localhost:5432/aftercare

# Resend — transactional email (sign-in links, invites, reminders).
# Without it, emails are printed to the server console instead of sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
EMAIL_FROM="AfterCare <no-reply@aftercare-uk.co.uk>"

# OpenAI — powers the AI assistant page. Without it the assistant falls back
# to built-in answers for common questions.
OPENAI_API_KEY=

# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
